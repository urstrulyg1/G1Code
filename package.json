{
  "name": "g1code-ai-ide",
  "version": "0.1.0",
  "private": true,
  "description": "G1Code AI IDE",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --config apps/desktop/vite.config.ts\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -p apps/desktop/tsconfig.json && vite build --config apps/desktop/vite.config.ts && tsc -p apps/desktop/tsconfig.electron.json",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,html,md}\" \"!package-lock.json\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "better-sqlite3": "^13.0.3",
    "electron": "^32.1.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
